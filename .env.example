AI_PROVIDER=ollama                        # ollama (free, local) | openai (paid)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
OPENAI_API_KEY=                           # only required when AI_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=768                  # 768 for nomic-embed-text, 1536 for text-embedding-3-small
RELEVANCE_THRESHOLD=0.35
DATABASE_PATH=./data/inbox.db
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
